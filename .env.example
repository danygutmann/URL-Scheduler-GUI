# Bind to localhost when using a reverse proxy; use 0.0.0.0 for direct LAN access.
APP_BIND_ADDRESS=127.0.0.1
APP_HOST=0.0.0.0
APP_PORT=8080
APP_TIMEZONE=Europe/Berlin
APP_DATA_DIR=/app/data
APP_LOG_LEVEL=INFO

# Authentication is required. Generate all secrets before the first start.
APP_AUTH_ENABLED=true
APP_AUTH_USERNAME=admin
# Replace with output from: python -c "from app.security import hash_password; print(hash_password('your-long-password'))"
APP_AUTH_PASSWORD_HASH=replace-this-with-a-generated-pbkdf2-hash
# Generate a random URL-safe 32+ character value; retain it across restarts.
APP_SESSION_SECRET=replace-this-with-a-random-session-secret-at-least-32-characters
# Generate via Fernet.generate_key(); required when saving secret HTTP headers.
APP_ENCRYPTION_KEY=replace-with-fernet-key
APP_COOKIE_SECURE=false

MAX_CONCURRENT_JOBS=4
DEFAULT_TIMEOUT_SECONDS=15
LOG_RETENTION_DAYS=90
LOG_RETENTION_MAX_RUNS=10000
# Optional exact IP/CIDR allowlist, never hostnames. Example: 192.168.1.15,2001:db8::/32
APP_ALLOWED_PRIVATE_TARGETS=
# Set >0 only if response content should be stored in history.
APP_RESPONSE_PREVIEW_BYTES=0
