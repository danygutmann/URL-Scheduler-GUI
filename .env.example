# Nur für den Betrieb ohne Compose. Im Portainer-Stack stehen diese Werte in compose.yaml.
APP_PORT=8080
APP_TIMEZONE=Europe/Berlin
APP_LOG_LEVEL=INFO

# MariaDB (ohne DB_HOST wird SQLite unter APP_DATA_DIR verwendet)
DB_HOST=192.168.1.10
DB_PORT=3306
DB_NAME=url_scheduler
DB_USER=scheduler
DB_PASSWORD=change-me

# Login ist standardmäßig aus; Verschlüsselung nur aktiv, wenn APP_ENCRYPTION_KEY gesetzt ist.
APP_AUTH_ENABLED=false
APP_ENCRYPTION_KEY=

MAX_CONCURRENT_JOBS=4
DEFAULT_TIMEOUT_SECONDS=15
LOG_RETENTION_DAYS=90
LOG_RETENTION_MAX_RUNS=10000
APP_ALLOWED_PRIVATE_TARGETS=
APP_RESPONSE_PREVIEW_BYTES=0
